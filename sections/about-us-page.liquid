{{ 'about-us-page.css' | asset_url | stylesheet_tag }}

<div class="au-page">

  <!-- HERO -->
  <section class="au-hero">
    <div class="au-hero__overlay"></div>
    <div class="au-hero__content">
      <p class="au-hero__eyebrow">Est. 2023 · Fashion & Lifestyle</p>
      <h1 class="au-hero__heading">Inspired by You,<br>Crafted for Life</h1>
      <p class="au-hero__sub">We don't just make clothes — we craft confidence.</p>
      <a href="{{ routes.all_products_collection_url }}" class="au-btn">Explore the Collection</a>
    </div>
    <div class="au-hero__scroll">↓</div>
  </section>

  <!-- WHO WE ARE -->
  <section class="au-section au-who">
    <div class="au-container au-who__grid">
      <div class="au-who__text">
        <span class="au-label">Who We Are</span>
        <h2>Fashion born from passion, built on purpose.</h2>
        <p>Elvaroo was founded with one belief: that elegance should be accessible to everyone. We started as a small creative studio with big dreams, and today every stitch we produce carries the same love and craftsmanship that defined us from day one.</p>
        <p>We are a team of designers, storytellers, and tastemakers who refuse to settle for ordinary. Our collections are carefully curated to blend timeless aesthetics with modern sensibility — because style should never feel like an effort.</p>
        <a href="{{ routes.all_products_collection_url }}" class="au-btn au-btn--outline">Shop Now</a>
      </div>
      <div class="au-who__visual">
        <div class="au-who__badge">
          <span class="au-who__badge-number">100%</span>
          <span class="au-who__badge-text">Quality<br>Guaranteed</span>
        </div>
        <div class="au-who__card au-who__card--1">
          <div class="au-who__card-inner">
            <span class="au-who__card-icon">✦</span>
            <p>Timeless elegance meets modern design</p>
          </div>
        </div>
        <div class="au-who__card au-who__card--2">
          <div class="au-who__card-inner">
            <span class="au-who__card-icon">♡</span>
            <p>Every piece made with intention and love</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  









  <!-- CTA BANNER -->
  <section class="au-cta">
    <div class="au-container">
      <h2>Ready to wear your elegance?</h2>
      <p>Explore our latest collections and find pieces that speak to who you are.</p>
      <div class="au-cta__buttons">
        <a href="{{ routes.all_products_collection_url }}" class="au-btn">Shop the Collection</a>
        <a href="/pages/contact" class="au-btn au-btn--ghost">Contact Us</a>
      </div>
    </div>
  </section>

</div>

<style>
/* ─── Reset & Base ─────────────────────────────────── */
.au-page { font-family: 'Helvetica Neue', Arial, sans-serif; color: #111; overflow-x: hidden; }
.au-container { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
.au-section { padding: 100px 0; }
.au-label { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #b30000; margin-bottom: 16px; }
.au-label--light { color: #c0392b; }
h2 { font-size: clamp(28px, 4vw, 48px); font-weight: 800; line-height: 1.2; margin: 0 0 24px; }
p { font-size: 16px; line-height: 1.8; color: #555; margin: 0 0 20px; }

/* ─── Buttons ──────────────────────────────────────── */
.au-btn {
  display: inline-block; padding: 16px 36px; background: #b30000; color: #fff;
  font-weight: 700; font-size: 14px; letter-spacing: 1px; text-transform: uppercase;
  text-decoration: none; border-radius: 4px; transition: background .25s, transform .2s;
}
.au-btn:hover { background: #900; transform: translateY(-2px); }
.au-btn--outline {
  background: transparent; color: #111; border: 2px solid #111;
}
.au-btn--outline:hover { background: #111; color: #fff; }
.au-btn--ghost {
  background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.6);
}
.au-btn--ghost:hover { background: rgba(255,255,255,.1); transform: translateY(-2px); }

/* ─── Hero ─────────────────────────────────────────── */
.au-hero {
  position: relative; height: 90vh; min-height: 580px;
  background: linear-gradient(135deg, #0a0a0a 0%, #1c0000 50%, #0a0a0a 100%);
  display: flex; align-items: center; justify-content: center; text-align: center;
  overflow: hidden;
}
.au-hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse at center, rgba(179,0,0,.18) 0%, transparent 70%);
}
.au-hero__overlay {
  position: absolute; inset: 0;
  background: repeating-linear-gradient(
    0deg, transparent, transparent 60px, rgba(255,255,255,.015) 60px, rgba(255,255,255,.015) 61px
  );
}
.au-hero__content { position: relative; z-index: 2; padding: 32px; }
.au-hero__eyebrow {
  font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
  color: rgba(255,255,255,.5); margin-bottom: 24px;
}
.au-hero__heading {
  font-size: clamp(40px, 7vw, 88px); font-weight: 900; line-height: 1.1;
  color: #fff; margin: 0 0 24px;
  text-shadow: 0 2px 40px rgba(0,0,0,.6);
}
.au-hero__heading span { color: #e63030; }
.au-hero__sub {
  font-size: clamp(16px, 2vw, 22px); color: rgba(255,255,255,.65);
  margin: 0 auto 40px; max-width: 480px;
}
.au-hero__scroll {
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
  color: rgba(255,255,255,.3); font-size: 20px;
  animation: au-bounce 2s infinite;
}
@keyframes au-bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(8px)} }

/* ─── Who We Are ───────────────────────────────────── */
.au-who { background: #fff; }
.au-who__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.au-who__text h2 { color: #0a0a0a; }
.au-who__visual {
  position: relative; height: 420px;
}
.au-who__badge {
  position: absolute; top: 0; right: 0; width: 130px; height: 130px;
  background: #b30000; border-radius: 50%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; color: #fff; z-index: 3;
}
.au-who__badge-number { font-size: 28px; font-weight: 900; line-height: 1; }
.au-who__badge-text { font-size: 10px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin-top: 4px; opacity: .85; }
.au-who__card {
  position: absolute; background: #fff; border-radius: 16px;
  box-shadow: 0 20px 60px rgba(0,0,0,.1); padding: 28px;
  border-left: 4px solid #b30000;
}
.au-who__card--1 { bottom: 60px; left: 0; width: 260px; }
.au-who__card--2 { top: 80px; left: 60px; width: 240px; }
.au-who__card-inner { display: flex; gap: 14px; align-items: flex-start; }
.au-who__card-icon { font-size: 22px; flex-shrink: 0; margin-top: 2px; color: #b30000; }
.au-who__card-inner p { font-size: 14px; margin: 0; color: #333; line-height: 1.5; }



/* ─── Mission ──────────────────────────────────────── */
.au-mission {
  background: #0a0a0a; text-align: center;
}
.au-mission .au-container { max-width: 800px; }
.au-mission h2 { color: #fff; font-size: clamp(28px, 4vw, 52px); }
.au-mission p { color: rgba(255,255,255,.6); font-size: 18px; }

/* ─── Values ───────────────────────────────────────── */
.au-values { background: #f8f8f8; text-align: center; }
.au-values h2 { margin-bottom: 60px; color: #0a0a0a; }
.au-values__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 28px; }
.au-value-card {
  background: #fff; border-radius: 16px; padding: 40px 28px;
  box-shadow: 0 4px 24px rgba(0,0,0,.06);
  transition: transform .25s, box-shadow .25s;
}
.au-value-card:hover { transform: translateY(-6px); box-shadow: 0 16px 48px rgba(0,0,0,.12); }
.au-value-card__icon { font-size: 40px; margin-bottom: 20px; display: block; }
.au-value-card h3 { font-size: 18px; font-weight: 700; margin: 0 0 12px; color: #0a0a0a; }
.au-value-card p { font-size: 14px; margin: 0; color: #666; }

/* ─── Stats ────────────────────────────────────────── */
.au-stats { background: #b30000; padding: 80px 0; }
.au-stats__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 40px; text-align: center; }
.au-stat__number { display: block; font-size: clamp(36px, 5vw, 60px); font-weight: 900; color: #fff; line-height: 1; }
.au-stat__label { display: block; font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,.7); margin-top: 10px; }

/* ─── Promise ──────────────────────────────────────── */
.au-promise { background: #fff; }
.au-promise__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 40px; text-align: center; }
.au-promise__icon { font-size: 40px; margin-bottom: 20px; }
.au-promise__item h3 { font-size: 18px; font-weight: 700; color: #0a0a0a; margin: 0 0 12px; }
.au-promise__item p { font-size: 14px; color: #666; margin: 0; }

/* ─── CTA ──────────────────────────────────────────── */
.au-cta {
  background: linear-gradient(135deg, #0a0a0a 0%, #1c0000 100%);
  padding: 120px 0; text-align: center;
}
.au-cta h2 { color: #fff; margin-bottom: 16px; }
.au-cta p { color: rgba(255,255,255,.6); font-size: 18px; margin-bottom: 48px; }
.au-cta__buttons { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; }

/* ─── Responsive ───────────────────────────────────── */
@media (max-width: 900px) {
  .au-who__grid { grid-template-columns: 1fr; gap: 40px; }
  .au-who__visual { display: none; }
  .au-values__grid { grid-template-columns: repeat(2,1fr); }
  .au-stats__grid { grid-template-columns: repeat(2,1fr); }
  .au-promise__grid { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 600px) {
  .au-section { padding: 60px 0; }
  .au-values__grid { grid-template-columns: 1fr; }
  .au-stats__grid { grid-template-columns: repeat(2,1fr); }
  .au-promise__grid { grid-template-columns: 1fr; }
  .au-container { padding: 0 20px; }
}
</style>

{% schema %}
{
  "name": "About Us Page",
  "tag": "section",
  "class": "section"
}
{% endschema %}
