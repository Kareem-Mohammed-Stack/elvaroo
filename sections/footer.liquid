{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --orca-foot-accent: {{ section.settings.accent | default: '#C11D1E' }};
    --orca-foot-logo: {{ section.settings.logo_width | default: 140 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .orca-foot {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .orca-foot {
      margin-top: {{ section.settings.margin_top }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign facebook_url = section.settings.facebook_url | default: settings.social_facebook_link
  assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link
  assign logo_text = section.settings.logo_text | default: shop.name
  assign shipping_url = shop.shipping_policy.url
  if shipping_url == blank
    assign shipping_url = '/policies/shipping-policy'
  endif
  assign shipping_title = 'sections.footer.shipping_policy' | t
  if shop.shipping_policy.title != blank
    assign shipping_title = shop.shipping_policy.title
  endif
-%}

<footer class="orca-foot footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width orca-foot__inner">
    <div class="orca-foot__grid">
      {%- if section.settings.show_brand -%}
        <div class="orca-foot__brand">
          <a href="{{ routes.root_url }}" class="orca-foot__logo-link">
            {%- if section.settings.logo != blank -%}
              {{
                section.settings.logo
                | image_url: width: 360
                | image_tag:
                  class: 'orca-foot__logo',
                  loading: 'lazy',
                  widths: '140, 200, 280, 360',
                  alt: shop.name
              }}
            {%- else -%}
              <img
                src="{{ 'Elvaroo Logo-03 copy.svg' | asset_url }}"
                alt="{{ shop.name | default: 'Elvaroo' | escape }}"
                class="orca-foot__logo"
                width="160"
                height="106"
                loading="lazy"
              >
            {%- endif -%}
          </a>
          {%- if section.settings.tagline != blank -%}
            <p class="orca-foot__tagline">{{ section.settings.tagline | escape }}</p>
          {%- endif -%}
          {%- if section.settings.show_social -%}
            {% render 'orca-footer-social', facebook: facebook_url, instagram: instagram_url %}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign append_shipping = false
          if section.settings.show_shipping_policy and block.type == 'link_list'
            if block.settings.menu.handle == 'footer' or block.settings.heading == 'Information'
              assign append_shipping = true
              for link in block.settings.menu.links
                if link.url contains 'shipping'
                  assign append_shipping = false
                endif
              endfor
            endif
          endif
        -%}
        <div class="orca-foot__group" {{ block.shopify_attributes }}>
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- else -%}
            <details class="orca-foot__details" open>
              {%- if block.settings.heading != blank -%}
                <summary class="orca-foot__heading">
                  <span>{{ block.settings.heading | escape }}</span>
                  <span class="orca-foot__plus" aria-hidden="true"></span>
                </summary>
              {%- endif -%}

              <div class="orca-foot__panel">
                {%- case block.type -%}
                  {%- when 'link_list' -%}
                    {%- assign heading_up = block.settings.heading | upcase -%}
                    {%- if heading_up == 'INFORMATION' -%}
                      <ul class="orca-foot__links" role="list">
                        <li>
                          <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" class="orca-foot__link">
                            Privacy Policy
                          </a>
                        </li>
                        <li>
                          <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}" class="orca-foot__link">
                            Refund Policy
                          </a>
                        </li>
                        <li>
                          <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}" class="orca-foot__link">
                            Terms of Service
                          </a>
                        </li>
                        <li>
                          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}" class="orca-foot__link">
                            Shipping policy
                          </a>
                        </li>
                        <li>
                          <a href="/pages/about-us" class="orca-foot__link">
                            About Us
                          </a>
                        </li>
                      </ul>
                    {%- elsif block.settings.menu != blank or append_shipping -%}
                      <ul class="orca-foot__links" role="list">
                        {%- if block.settings.menu != blank -%}
                          {%- for link in block.settings.menu.links -%}
                            <li>
                              <a href="{{ link.url }}" class="orca-foot__link{% if link.active %} is-active{% endif %}">
                                {{ link.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        {%- endif -%}
                        {%- if append_shipping -%}
                          <li>
                            <a href="{{ shipping_url }}" class="orca-foot__link">
                              {{ shipping_title | escape }}
                            </a>
                          </li>
                        {%- endif -%}
                      </ul>
                    {%- endif -%}
                  {%- when 'text' -%}
                    <div class="orca-foot__text rte">
                      {%- if block.settings.subtext != blank -%}
                        {{ block.settings.subtext }}
                      {%- endif -%}
                      {%- if shop.email != blank -%}
                        <p>
                          <a class="orca-foot__link" href="mailto:{{ shop.email }}">{{ shop.email }}</a>
                        </p>
                      {%- endif -%}
                    </div>
                  {%- when 'brand_information' -%}
                    <div class="orca-foot__text rte">
                      {%- if settings.brand_description != blank -%}
                        {{ settings.brand_description }}
                      {%- endif -%}
                    </div>
                  {%- when 'image' -%}
                    {%- if block.settings.image != blank -%}
                      <div class="orca-foot__image" style="max-width: {{ block.settings.image_width }}px;">
                        {{
                          block.settings.image
                          | image_url: width: 700
                          | image_tag: loading: 'lazy', widths: '200, 400, 700', alt: block.settings.image.alt
                        }}
                      </div>
                    {%- endif -%}
                  {%- when 'big_image' -%}
                    {%- if block.settings.image_drawer != blank -%}
                      <div class="orca-foot__image">
                        {{
                          block.settings.image_drawer
                          | image_url: width: 900
                          | image_tag: loading: 'lazy', widths: '400, 700, 900', alt: block.settings.image_drawer.alt
                        }}
                      </div>
                    {%- endif -%}
                {%- endcase -%}
              </div>
            </details>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.newsletter_enable -%}
      <div class="orca-foot__newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="orca-foot__heading orca-foot__heading--static">{{ section.settings.newsletter_heading }}</h2>
        {%- endif -%}
        {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__field-wrapper">
            <div class="field">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="field__input"
                value="{{ form.email }}"
                aria-required="true"
                autocomplete="email"
                placeholder="{{ 'newsletter.label' | t }}"
                required
              >
              <label class="field__label" for="NewsletterForm--{{ section.id }}">
                {{ 'newsletter.label' | t }}
              </label>
              <button
                type="submit"
                class="newsletter-form__button field__button"
                name="commit"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                {% render 'icon-arrow' %}
              </button>
            </div>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
      <div class="orca-foot__follow">
        {% # theme-check-disable %}
        {{ shop | login_button: action: 'follow' }}
        {% # theme-check-enable %}
      </div>
    {%- endif -%}
  </div>

  <div class="orca-foot__bottom">
    <div class="page-width orca-foot__bottom-inner">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1
        or section.settings.enable_language_selector and localization.available_languages.size > 1
      -%}
        <div class="orca-foot__localize">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div class="no-js-hidden">
                  <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div class="no-js-hidden">
                  <h2 class="visually-hidden" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.payment_enable -%}
        {% render 'payment-icons-footer' %}
      {%- endif -%}

      {%- if section.settings.show_policy -%}
        <ul class="orca-foot__policies" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li>
                <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.show_shipping_policy -%}
            {%- assign policy_has_shipping = false -%}
            {%- for policy in shop.policies -%}
              {%- if policy.url contains 'shipping' -%}
                {%- assign policy_has_shipping = true -%}
              {%- endif -%}
            {%- endfor -%}
            {%- unless policy_has_shipping -%}
              <li>
                <a href="{{ shipping_url }}">{{ shipping_title | escape }}</a>
              </li>
            {%- endunless -%}
          {%- endif -%}
        </ul>
      {%- endif -%}

      <p class="orca-foot__copy">
        <span>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | default: 'Elvaroo' | escape }} Developed and Designed by <a href="https://orcaad.com" target="_blank" rel="noopener noreferrer">OrcaAd</a></span>
      </p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .orca-foot {
    --orca-foot-accent: #c11d1e;
    --orca-foot-logo: 140px;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .orca-foot__inner {
    display: grid;
    gap: 3.6rem;
  }

  .orca-foot__grid {
    display: grid;
    gap: 2.4rem;
  }

  .orca-foot__brand {
    display: grid;
    gap: 1.2rem;
    justify-items: center;
    text-align: center;
    max-width: 32rem;
    margin: 0 auto;
  }

  .orca-foot__logo-link {
    display: inline-block;
    text-decoration: none;
    color: inherit;
    margin: 0 auto;
  }

  .orca-foot__logo {
    display: block;
    margin: 0 auto;
    width: auto;
    max-width: var(--orca-foot-logo);
    max-height: 5.6rem;
    object-fit: contain;
  }

  .orca-foot__wordmark {
    display: block;
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 3vw, 3.6rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .orca-foot__tagline {
    margin: 0;
    color: rgba(var(--color-foreground), 0.62);
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .orca-foot__social {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    margin: 0.6rem auto 0;
    padding: 0;
    list-style: none;
  }

  .orca-foot__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 999px;
    color: inherit;
    background: rgb(var(--color-background));
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .orca-foot__social-link .icon {
    width: 1.8rem;
    height: 1.8rem;
  }

  .orca-foot__social-link:hover,
  .orca-foot__social-link:focus-visible {
    background: var(--orca-foot-accent);
    border-color: var(--orca-foot-accent);
    color: #fff;
  }

  .orca-foot__details {
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .orca-foot__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 1.6rem 0;
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }

  .orca-foot__heading--static {
    cursor: default;
    padding: 0 0 1.2rem;
  }

  .orca-foot__heading::-webkit-details-marker {
    display: none;
  }

  .orca-foot__plus {
    position: relative;
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
  }

  .orca-foot__plus::before,
  .orca-foot__plus::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    border-radius: 99px;
    transform: translate(-50%, -50%);
  }

  .orca-foot__plus::before {
    width: 1.2rem;
    height: 1.5px;
  }

  .orca-foot__plus::after {
    width: 1.5px;
    height: 1.2rem;
    transition: transform 280ms ease, opacity 280ms ease;
  }

  .orca-foot__details[open] .orca-foot__plus::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .orca-foot__links,
  .orca-foot__policies {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0 0 1.6rem;
    list-style: none;
  }

  .orca-foot__link,
  .orca-foot__text,
  .orca-foot__policies a {
    color: rgba(var(--color-foreground), 0.78);
    font-size: 1.6rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .orca-foot__link:hover,
  .orca-foot__link:focus-visible,
  .orca-foot__link.is-active,
  .orca-foot__policies a:hover {
    color: rgb(var(--color-foreground));
  }

  .orca-foot__text {
    padding-bottom: 1.6rem;
  }

  .orca-foot__text > *:first-child {
    margin-top: 0;
  }

  .orca-foot__text > *:last-child {
    margin-bottom: 0;
  }

  .orca-foot__image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .orca-foot__bottom {
    margin-top: 2.4rem;
    padding-top: 2.4rem;
    padding-bottom: 0.8rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .orca-foot__bottom-inner {
    display: grid;
    gap: 1.6rem;
    justify-items: center;
    text-align: center;
  }

  .orca-foot__copy {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    margin: 0;
    padding-bottom: 0.4rem;
    color: rgba(var(--color-foreground), 0.55);
    font-size: 1.3rem;
  }

  .orca-foot__copy a {
    color: inherit;
    text-decoration: none;
  }

  .orca-foot__credit a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .orca-foot .list-payment-footer {
    justify-content: center;
    gap: 0.8rem;
    margin: 0;
  }

  .orca-foot__policies {
    grid-auto-flow: column;
    justify-content: center;
    padding-bottom: 0;
    gap: 1.2rem 1.8rem;
  }

  @media screen and (min-width: 750px) {
    .orca-foot__grid {
      grid-template-columns: minmax(18rem, 1.3fr) repeat(3, minmax(0, 1fr));
      gap: 4rem 3.2rem;
      align-items: start;
    }

    .orca-foot__details {
      border-top: 0;
    }

    .orca-foot__heading {
      padding: 0 0 1.4rem;
      cursor: default;
      pointer-events: none;
    }

    .orca-foot__plus {
      display: none;
    }

    .orca-foot__links,
    .orca-foot__text {
      padding-bottom: 0;
    }

    .orca-foot__bottom-inner {
      justify-items: stretch;
      text-align: left;
    }

    .orca-foot__copy {
      justify-content: center;
    }

    .orca-foot .list-payment-footer {
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.brand_information.settings.header__1.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Share contact information, store details, and brand content with your customers.</p>",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Image width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Image alignment on large screen",
          "options": [
            { "value": "", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "big_image",
      "name": "Ancher Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_drawer",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_size",
          "label": "Feature Image Size",
          "min": 20,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 100
        },
        {
          "type": "range",
          "id": "image_border",
          "label": "Image corner radius",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "select",
          "id": "img_position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center",
          "label": "Image Position"
        },
        {
          "type": "range",
          "id": "padding_top_image",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "t:sections.all.padding.padding_top",
          "default": 16
        },
        {
          "type": "range",
          "id": "padding_bottom_image",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "t:sections.all.padding.padding_bottom",
          "default": 16
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#C11D1E"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "checkbox",
      "id": "show_brand",
      "default": true,
      "label": "Show logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 220,
      "step": 5,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Text logo",
